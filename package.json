{
  "name": "gusto",
  "version": "0.1.0",
  "description": "Family recipe book that stores every recipe as a Google Doc in a shared Google Drive folder.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "start": "NODE_ENV=production bun src/index.ts",
    "build": "bun run build.ts",
    "typecheck": "bun check",
    "test": "bun test",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "verify": "bun run format:check && bun run typecheck && bun test && bun run build"
  },
  "dependencies": {
    "bun-plugin-tailwind": "^0.1.2",
    "lucide-react": "^1.80.0",
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.9",
    "@types/bun": "latest",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4.1.11"
  },
  "peerDependencies": {
    "typescript": "^7"
  }
}
